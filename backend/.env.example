# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres

# JWT
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_EXPIRATION=24h

# Application
PORT=3000
NODE_ENV=development

# Admin seed (obrigatório para rodar `npm run seed`)
ADMIN_EMAIL=admin@glitch.com.br
ADMIN_PASSWORD=troque-esta-senha-antes-de-usar

# Uploads
UPLOADS_DIR=uploads

# CORS (separado por vírgula) — painel admin (5173) e loja pública (3001) em dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
